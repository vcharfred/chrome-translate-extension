{
  "manifest_version": 3,
  "name": "AI 网页翻译",
  "version": "1.3.1",
  "description": "整页翻译 + 划词翻译，支持 DeepSeek / 阿里云百炼(通义千问) / 腾讯混元大模型，密钥加密管理、不暴露给网页。",
  "permissions": ["storage", "contextMenus", "activeTab"],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.hunyuan.cloud.tencent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI 网页翻译",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
